# Cloudflare Analytics API token
# Required permissions: Analytics:Read on both zones listed below.
CLOUDFLARE_API_TOKEN=<your-api-token>

# Zone ID for cambridge.edu.au (used by /get-top-urls endpoints)
CLOUDFLARE_ZONE_ID=<zone-id-edu-au>

# Zone ID for www.cambridge.org (used by /http-urls endpoints)
# Note: this zone belongs to a different Cloudflare account than CLOUDFLARE_ZONE_ID.
CLOUDFLARE_ZONE_ID_ORG=<zone-id-org>

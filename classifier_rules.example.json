{
  "streams": [
    {
      "name": "api",
      "include": ["^/api(?:/|$)"]
    },
    {
      "name": "static",
      "include": ["\\.(?:js|css|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|ico)$"]
    },
    {
      "name": "app",
      "include": ["^/.+"],
      "exclude": ["^/(?:robots\\.txt|favicon\\.ico|ads\\.txt)$"]
    }
  ],
  "default": "unmatched"
}
